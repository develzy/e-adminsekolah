// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  npsn         String   @unique
  address      String?
  phone        String?
  level        String   // TK, RA, SD, MI, SMP, MTs, SMA, MA, SMK, PESANTREN
  status       String   @default("active") // active, suspended
  capacity     Int      @default(500)      // Max student capacity
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
}

model User {
  id            String      @id @default(uuid())
  name          String?
  email         String      @unique
  emailVerified DateTime?
  image         String?
  password      String
  role          String      @default("guru") // super_admin, admin_sekolah, guru, siswa, orang_tua
  tenantId      String?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userPopups    UserPopup[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Popup {
  id            String      @id @default(uuid())
  title         String
  message       String      @db.Text
  type          String      // welcome, warning, loading, success, error, maintenance, feature_update, announcement, security, multi_login, tutorial, session_expired, ai_processing, system_info, school_info, wa_contact, realtime, backup_reminder, sync_success, dev_announcement
  targetRole    String?     // null means all roles, otherwise specific role e.g. "admin_sekolah"
  targetTenant  String?     // null means all tenants, otherwise specific tenant ID
  targetJenjang String?     // null means all levels, otherwise e.g. "SMK" or "SD"
  isGlobal      Boolean     @default(true)
  priority      Int         @default(0) // Higher numbers indicate higher priority
  dismissible   Boolean     @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userPopups    UserPopup[]
}

model UserPopup {
  id          String   @id @default(uuid())
  userId      String
  popupId     String
  dismissed   Boolean  @default(true)
  seenAt      DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  popup       Popup    @relation(fields: [popupId], references: [id], onDelete: Cascade)

  @@unique([userId, popupId])
}
